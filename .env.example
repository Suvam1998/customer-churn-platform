# ==========================================================================
# Environment variables — copy to `.env` and fill in. NEVER commit `.env`.
# All values below are placeholders / safe local defaults.
# ==========================================================================

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Dashboard ---
DASHBOARD_API_BASE_URL=http://localhost:8000

# --- Streaming: "local" (in-process simulation) or "kafka" ---
STREAMING_MODE=local
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- PostgreSQL (Phase 14) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=churn
POSTGRES_USER=churn_user
POSTGRES_PASSWORD=change_me
# SQLAlchemy URL derived from the above, or set directly:
# DATABASE_URL=postgresql+psycopg2://churn_user:change_me@localhost:5432/churn

# --- MLflow (Phase 19) ---
MLFLOW_TRACKING_URI=file:./mlruns

# --- Snowflake (Phase 22, OPTIONAL — leave blank to disable) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
